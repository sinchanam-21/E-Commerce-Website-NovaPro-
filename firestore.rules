rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read catalog metadata, custom products, and reviews
    // Store owner or client can write catalog updates
    match /catalog_sync/{document=**} {
      allow read, write: if true;
    }
    match /products/{productId} {
      allow read, write: if true;
    }
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /store_settings/{settingId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
